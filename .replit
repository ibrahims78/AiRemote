modules = ["web", "nodejs-22", "python-3.11"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3003

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AiRemote Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AiRemote Dashboard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AiRemote Agent (Dev)"

[[workflows.workflow]]
name = "AiRemote Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd packages/server && pnpm dev"
waitForPort = 3001

[[workflows.workflow]]
name = "AiRemote Dashboard"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd packages/dashboard && pnpm dev"
waitForPort = 5000

[[workflows.workflow]]
name = "AiRemote Agent (Dev)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd packages/agent && SERVER_URL=ws://localhost:3001/ws DEVICE_TOKEN=756be3ba-fa6f-40f4-894c-ca668e744ce5-f31801de-2c10-4beb-b2f0-e9009551f17f pnpm dev"

[workflows.workflow.metadata]
outputType = "console"

[userenv]

[userenv.shared]
PORT = "3001"
HOST = "0.0.0.0"
NODE_ENV = "development"
LOG_LEVEL = "info"
DB_PATH = "./data/airemote.db"
DASHBOARD_URL = "true"
JWT_SECRET = "780f3568748763c60042ca3891327db9c1102c733403c292539f1979a3bc3ca3c7e0dbf0360aa29c31ab75780f8ceba6"

[nix]
channel = "stable-25_05"
