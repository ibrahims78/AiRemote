modules = ["web", "nodejs-22", "python-3.11"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3003

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AiRemote Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AiRemote Dashboard"

[[workflows.workflow]]
name = "AiRemote Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd packages/server && pnpm dev"
waitForPort = 3001

[[workflows.workflow]]
name = "AiRemote Dashboard"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd packages/dashboard && pnpm dev"
waitForPort = 5000

[userenv]

[userenv.shared]
PORT = "3001"
HOST = "0.0.0.0"
NODE_ENV = "development"
LOG_LEVEL = "info"
DB_PATH = "./data/airemote.db"
DASHBOARD_URL = "true"
JWT_SECRET = "d974b67917e5d3dc59f11c95d08f878b6bcd1434d9d20a26910eb20243d4e7992a3e8ce5058ad904f5a5402043788f63d93368f3ee05d30171a28ab7ee0efc2b"

[nix]
channel = "stable-25_05"
