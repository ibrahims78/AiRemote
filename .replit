modules = ["web", "nodejs-22"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AiRemote Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AiRemote Dashboard"

[[workflows.workflow]]
name = "AiRemote Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "packages/server/node_modules/.bin/tsx watch packages/server/src/index.ts"
waitForPort = 3001

[[workflows.workflow]]
name = "AiRemote Dashboard"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd packages/dashboard && pnpm dev"
waitForPort = 5000

[userenv]

[userenv.shared]
PORT = "3001"
HOST = "0.0.0.0"
NODE_ENV = "development"
LOG_LEVEL = "info"
DB_PATH = "./data/airemote.db"

[nix]
channel = "stable-25_05"
