modules = ["web", "nodejs-22", "python-3.11"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AiRemote Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AiRemote Dashboard"

[[workflows.workflow]]
name = "AiRemote Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @airemote/shared build && pnpm --filter @airemote/ai-engine build && cd packages/server && pnpm dev"
waitForPort = 3001

[[workflows.workflow]]
name = "AiRemote Dashboard"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd packages/dashboard && pnpm dev"
waitForPort = 5000

[userenv]

[userenv.shared]
PORT = "3001"
HOST = "0.0.0.0"
NODE_ENV = "development"
LOG_LEVEL = "info"
DB_PATH = "./data/airemote.db"
DASHBOARD_URL = "true"
JWT_SECRET = "fa0d998283e25da6fea0c31ad6ad322494f4e4291f437144a6891ed140c39f49cda1bc43418d933957c18678b0d93a966c6e77e473eeefc033ecb589bb4b4971"

[nix]
channel = "stable-25_05"
