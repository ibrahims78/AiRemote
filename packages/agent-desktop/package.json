{
  "name": "airemote-agent-desktop",
  "version": "1.5.0",
  "description": "AiRemote Agent — Windows Desktop Application",
  "author": "AiRemote <support@airemote.io>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64",
    "build:portable": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --config.win.target=portable",
    "build:dir": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.airemote.agent",
    "productName": "AiRemote Agent",
    "copyright": "Copyright © 2025 AiRemote",
    "artifactName": "AiRemote-Agent-v${version}-Windows-x64.exe",
    "directories": {
      "output": "../../releases/agent-windows"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.ico",
      "node_modules/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false,
      "signingHashAlgorithms": null
    },
    "portable": {
      "requestExecutionLevel": "user",
      "unpackDirName": "airemote-agent"
    },
    "publish": null
  }
}