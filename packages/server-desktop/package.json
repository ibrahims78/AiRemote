{
  "name": "airemote-server-desktop",
  "version": "3.2.0",
  "description": "AiRemote Server — Windows Desktop Application",
  "main": "main.js",
  "author": "AiRemote",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^8.1.1",
    "@fastify/websocket": "^10.0.1",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.6.0",
    "fastify": "^4.28.0",
    "jsonwebtoken": "^9.0.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.airemote.server",
    "productName": "AiRemote Server",
    "copyright": "Copyright © 2025 AiRemote",
    "directories": {
      "output": "../../releases/server-windows"
    },
    "files": [
      "main.js",
      "server.js",
      "tunnel.js",
      "logger.js",
      "backup.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.ico",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "bin/cloudflared.exe",
        "to": "cloudflared.exe",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [{ "target": "zip", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "AiRemote-Server-v${version}-Windows-x64.zip",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false,
      "signingHashAlgorithms": null
    },
    "nativeRebuilder": "sequential",
    "publish": null
  }
}
